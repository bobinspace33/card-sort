# Optional: Gemini (only if you add features that call the API)
GEMINI_API_KEY=

# Optional: override Firebase client config (recommended for Vercel instead of committing keys)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# Named Firestore database (default is (default); your AI Studio app may use a custom id)
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=
